# Text files are checked out with LF on every platform, also where Git would
# write CRLF (core.autocrlf on Windows): tests compare generated files byte for
# byte and read `\n`-separated lines, and ISCC reads the Inno script with LF.
* text=auto eol=lf

# Binary formats in the repository, so Git never takes one for text.
*.bin binary
*.class binary
*.dat binary
*.glb binary
*.gz binary
*.ico binary
*.litematic binary
*.mca binary
*.mcstructure binary
*.otf binary
*.png binary
*.schem binary
*.ttf binary
*.zip binary
