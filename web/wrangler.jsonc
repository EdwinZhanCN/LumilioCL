// launcher.lumilio.org: one Worker serving the built site (`dist/`) and,
// for /releases/* only, the GitHub release mirror (worker/proxy.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumilio-launcher",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/releases/*"]
  },
  "routes": [{ "pattern": "launcher.lumilio.org", "custom_domain": true }],
  "observability": { "enabled": true }
}
